# PostgreSQL (docker compose up -d db)
DATABASE_URL="postgresql://tir:tir@localhost:5432/tir?schema=public"

# Auth.js — згенеруйте: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true

# Демо-режим: підказка з демо-доступами на сторінці входу, robots.txt забороняє індексацію
DEMO_MODE=true

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Куди зберігати завантажені фото (за замовчуванням ./storage/uploads)
# UPLOAD_DIR="./storage/uploads"
